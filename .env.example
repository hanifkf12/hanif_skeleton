NAME=test
PORT=9000
DB_DRIVER=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_NAME=test_skeleton

# Crypto Configuration
# Generate key: openssl rand -base64 32
ENCRYPTION_KEY=change-me-generate-with-openssl-rand-base64-32
BCRYPT_COST=10

# JWT Configuration
# Generate key: openssl rand -base64 32
JWT_SECRET_KEY=change-me-generate-with-openssl-rand-base64-32
JWT_ISSUER=hanif-skeleton
JWT_EXPIRY=24h

# Cache Configuration
# Options: redis, memory
CACHE_DRIVER=memory
CACHE_HOST=localhost
CACHE_PORT=6379
CACHE_PASSWORD=
CACHE_DB=0

# HTTP Client Configuration
HTTP_CLIENT_TIMEOUT=30s
HTTP_CLIENT_MAX_RETRIES=3
HTTP_CLIENT_RETRY_WAIT_TIME=1s
HTTP_CLIENT_FOLLOW_REDIRECT=true

# Queue Configuration
# Options: asynq
QUEUE_DRIVER=asynq
QUEUE_HOST=localhost
QUEUE_PORT=6379
QUEUE_PASSWORD=
QUEUE_DB=1

